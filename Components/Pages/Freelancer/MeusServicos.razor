@page "/freelancer/meus-servicos"
@rendermode InteractiveServer

@attribute [Authorize(Roles = "freelancer")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using global::GestaoFreela.Data
@using global::GestaoFreela.Models
@using global::GestaoFreela.Models.Enums
@using Microsoft.AspNetCore.Identity

@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<MeusServicos> Logger

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fas fa-briefcase text-success me-2"></i>
                    Meus Serviços
                </h2>
                <div class="d-flex gap-2">
                    <select @onchange="OnStatusChanged" class="form-select" style="width: auto;">
                        <option value="">Todos os Status</option>
                        <option value="@((int)StatusServico.Ativo)">Ativo</option>
                        <option value="@((int)StatusServico.EmAndamento)">Em Andamento</option>
                        <option value="@((int)StatusServico.Finalizado)">Finalizado</option>
                        <option value="@((int)StatusServico.Cancelado)">Cancelado</option>
                    </select>
                </div>
            </div>

            <!-- Lista de Serviços -->
            <div class="row">
                @if (servicosFiltrados == null)
                {
                    <div class="col-12 text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Carregando...</span>
                        </div>
                    </div>
                }
                else if (!servicosFiltrados.Any())
                {
                    <div class="col-12">
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle me-2"></i>
                            @if (string.IsNullOrEmpty(filtroStatus))
                            {
                                <span>Você ainda não foi aceito em nenhum serviço.</span>
                            }
                            else
                            {
                                <span>Nenhum serviço encontrado com o status selecionado.</span>
                            }
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var item in servicosFiltrados)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0">@item.Servico.Nome</h6>
                                    <span class="badge @GetStatusBadgeClass(item.Servico.Status)">
                                        @GetStatusText(item.Servico.Status)
                                    </span>
                                </div>
                                <div class="card-body">
                                    <p class="card-text small">@item.Servico.Descricao</p>
                                    <div class="row g-2 small">
                                        <div class="col-6">
                                            <strong>Valor:</strong> R$ @item.Servico.Valor.ToString("N2")
                                        </div>
                                        <div class="col-6">
                                            <strong>Nível:</strong> @GetNivelText(item.Servico.Nivel)
                                        </div>
                                        <div class="col-6">
                                            <strong>Cliente:</strong> @item.Servico.Cliente.Nome
                                        </div>
                                        <div class="col-6">
                                            <strong>Telefone:</strong> @item.Servico.Cliente.Telefone
                                        </div>
                                        <div class="col-12">
                                            <strong>Categoria:</strong> @item.Servico.Categoria.Nome
                                        </div>
                                        <div class="col-6">
                                            <strong>Início:</strong> @item.Servico.DataInicio.ToString("dd/MM/yyyy")
                                        </div>
                                        <div class="col-6">
                                            <strong>Aceito em:</strong> @item.DataResposta?.ToString("dd/MM/yyyy")
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer">
                                    <div class="d-flex justify-content-center">
                                        <span class="badge bg-success fs-6">
                                            <i class="fas fa-check me-1"></i>
                                            Participando do Projeto
                                        </span>
                                    </div>
                                    @if (item.Servico.Status == StatusServico.EmAndamento)
                                    {
                                        <div class="mt-2 text-center">
                                            <small class="text-muted">
                                                <i class="fas fa-info-circle me-1"></i>
                                                Projeto em andamento
                                            </small>
                                        </div>
                                    }
                                    else if (item.Servico.Status == StatusServico.Finalizado)
                                    {
                                        <div class="mt-2 text-center">
                                            <small class="text-success">
                                                <i class="fas fa-check-circle me-1"></i>
                                                Projeto finalizado
                                            </small>
                                        </div>
                                    }
                                    else if (item.Servico.Status == StatusServico.Cancelado)
                                    {
                                        <div class="mt-2 text-center">
                                            <small class="text-danger">
                                                <i class="fas fa-times-circle me-1"></i>
                                                Projeto cancelado
                                            </small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensagem))
{
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 11">
        <div class="toast show" role="alert">
            <div class="toast-header">
                <strong class="me-auto">Notificação</strong>
                <button type="button" class="btn-close" @onclick="() => mensagem = string.Empty"></button>
            </div>
            <div class="toast-body">
                @mensagem
            </div>
        </div>
    </div>
}

@code {
    private List<FreelancerServico>? meusServicos;
    private List<FreelancerServico>? servicosFiltrados;
    private ApplicationUser? currentUser;
    
    private string filtroStatus = "";
    private string mensagem = "";

    protected override async Task OnInitializedAsync()
    {
        await CarregarUsuarioAtual();
        await CarregarMeusServicos();
        FiltrarServicos();
    }

    private async Task CarregarUsuarioAtual()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            currentUser = await UserManager.GetUserAsync(authState.User);
        }
    }

    private async Task CarregarMeusServicos()
    {
        if (currentUser == null) return;

        meusServicos = await DbContext.FreelancerServicos
            .Include(fs => fs.Servico)
                .ThenInclude(s => s.Categoria)
            .Include(fs => fs.Servico)
                .ThenInclude(s => s.Cliente)
            .Where(fs => fs.FreelancerId == currentUser.Id && fs.Status == StatusParticipacao.Aceito)
            .OrderByDescending(fs => fs.DataResposta)
            .ToListAsync();
    }

    private void FiltrarServicos()
    {
        if (meusServicos == null)
        {
            servicosFiltrados = null;
            return;
        }

        var query = meusServicos.AsEnumerable();

        if (!string.IsNullOrEmpty(filtroStatus) && int.TryParse(filtroStatus, out int status))
        {
            query = query.Where(fs => (int)fs.Servico.Status == status);
        }

        servicosFiltrados = query.ToList();
    }

    private void OnStatusChanged(ChangeEventArgs e)
    {
        filtroStatus = e.Value?.ToString() ?? "";
        FiltrarServicos();
    }

    // Métodos auxiliares para exibição
    private string GetStatusBadgeClass(StatusServico status) => status switch
    {
        StatusServico.Ativo => "bg-success",
        StatusServico.EmAndamento => "bg-warning",
        StatusServico.Finalizado => "bg-primary",
        StatusServico.Cancelado => "bg-danger",
        StatusServico.AguardandoCompletarTime => "bg-secondary",
        _ => "bg-secondary"
    };

    private string GetStatusText(StatusServico status) => status switch
    {
        StatusServico.Ativo => "Ativo",
        StatusServico.EmAndamento => "Em Andamento",
        StatusServico.Finalizado => "Finalizado",
        StatusServico.Cancelado => "Cancelado",
        StatusServico.AguardandoCompletarTime => "Aguardando Time",
        _ => "Desconhecido"
    };

    private string GetNivelText(NivelServico nivel) => nivel switch
    {
        NivelServico.Junior => "Junior",
        NivelServico.Pleno => "Pleno",
        NivelServico.Senior => "Sênior",
        _ => "Não definido"
    };
}
